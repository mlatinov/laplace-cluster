
//@laplace 
//@brief Semi-supervised mixture log-likelihood
real mixture_ss_lpdf(matrix L, matrix log_theta, array[] int z) {
    int N = rows(L);
    int K = cols(L);
    real lp = 0;

    for (n in 1:N) {
        if (z[n] > 0) {
            lp += L[n, z[n]] + log_theta[n, z[n]];
        } else {
            vector[K] a;

            for (k in 1:K)
                a[k] = L[n,k] + log_theta[n,k];

            lp += log_sum_exp(a);
        }
    }

    return lp;
}

//@laplace
//@brief LDA log-likelihood from document-word counts
real lda_lpmf(array[,] int Y, matrix Theta, matrix Phi){
    int M = size(Y);
    int V = size(Y[1]);
    
    matrix[M, V] P = Theta * Phi;
    real out = 0;

    for (m in 1:M) {
        for (v in 1:V) {
            out += Y[m, v] * log(P[m, v]);
        }
    }
    return out;
}