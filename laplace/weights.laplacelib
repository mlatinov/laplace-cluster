
//@laplace
//@brief Stick-breaking construction of mixture weights from K-1 break proportions; base for the truncated Dirichlet-process prior.
//@param v length-(K-1) vector of break proportions in (0,1); K is inferred as num_elements(v) + 1
//@math \log\theta_k = \log v_k + \sum_{j<k}\log(1-v_j), \qquad \log\theta_K = \sum_{j<K}\log(1-v_j)
//@return length-K vector of log mixing weights, log-sums to 0
//@example vector[K-1] v; vector[K] log_theta = cluster::stick_breaking_log_weights(v);
vector stick_breaking_log_weights(vector v) {
    int K = num_elements(v) + 1;
    vector[K] log_theta;
    real remaining = 0;

    for (k in 1:(K - 1)) {
        log_theta[k] = log(v[k]) + remaining;
        remaining += log1m(v[k]);
    }

    log_theta[K] = remaining;

    return log_theta;
}

//@laplace
//@brief Covariate-dependent mixture weights via softmax regression, last class fixed as the zero-logit reference.
//@param X N x P design matrix (include an intercept column if wanted)
//@param G P x (K-1) matrix of coefficients for the first K-1 classes; K is inferred as cols(G) + 1
//@math \log\theta_{nk} = \tilde\eta_{nk} - \log\sum_{j=1}^{K}\exp(\tilde\eta_{nj}), \qquad \tilde\eta_{nK} = 0
//@return N x K matrix of observation-specific log mixing weights, each row log-sums to 0
//@example matrix[N, K] log_Theta = cluster::softmax_log_weights(X, G);
matrix softmax_log_weights(matrix X, matrix G) {
    int N = rows(X);
    int K = cols(G) + 1;

    matrix[N, K] eta;
    matrix[N, K] log_theta;

    eta[, 1:(K - 1)] = X * G;

    for (n in 1:N) {
        eta[n, K] = 0;
        log_theta[n, 1:K] = eta[n, 1:K]- log_sum_exp(eta[n, 1:K]);
    }
    
    return log_theta;
}