//Each function returns the N × K matrix L of component log-densities

//@laplace
//@brief Pairwise squared Euclidean distance between observations and cluster means, via the expansion trick (one matrix product instead of an N*K*D loop).
//@param y N x D data matrix, one observation per row
//@param mu K x D matrix of cluster means, one mean per row
//@math \delta_{nk} = \lVert y_n - \mu_k\rVert^2 = \lVert y_n\rVert^2 + \lVert\mu_k\rVert^2 - 2\,y_n\cdot\mu_k
//@return N x K matrix of squared distances
//@example matrix[N, K] delta = cluster::sq_dist(y, mu);
matrix sq_dist(matrix y, matrix mu) {
    int N = rows(y);
    int K = rows(mu);

    vector[N] rho;
    vector[K] kappa;

    for (n in 1:N) rho[n]   = dot_self(y[n]');
    for (k in 1:K) kappa[k] = dot_self(mu[k]');

    return rep_matrix(rho, K) + rep_matrix(kappa', N) - 2 * y * mu';
}

//@laplace
//@brief Soft k-means component log-densities: unit-shape Gaussian log-density up to a fixed temperature, constants dropped.
//@param y N x D data matrix
//@param mu K x D matrix of cluster means
//@param beta inverse-temperature / precision, beta = 1/sigma^2; beta = 1 recovers plain soft k-means
//@math L_{nk} = -\frac{\beta}{2}\lVert y_n - \mu_k\rVert^2
//@return N x K matrix of component log-densities (not a normalized log-density: constants are dropped, so don't compare across families)
//@example matrix[N, K] L = cluster::kmeans_loglik(y, mu, 1.0);
matrix kmeans_loglik(matrix y, matrix mu, real beta){
    int N = rows(y);
    int K = rows(mu);
    
    // Get the square distance
    matrix[N, K] sq = sq_dist(y, mu);
    return -(beta / 2) * sq;
}

//@laplace
//@brief Spherical Gaussian component log-densities: shared shape per cluster, one scale per cluster.
//@param y N x D data matrix
//@param mu K x D matrix of cluster means
//@param sd length-K vector of per-cluster standard deviations
//@math L_{nk} = -D\log\sigma_k - \frac{\lVert y_n-\mu_k\rVert^2}{2\sigma_k^2} - \frac{D}{2}\log 2\pi
//@return N x K matrix of component log-densities, D is inferred from cols(y)
//@example matrix[N, K] L = cluster::spherical_loglik(y, mu, sd);
matrix spherical_loglik(matrix y, matrix mu, vector sd){
    int N = rows(y);
    int K = rows(mu);
    int D = cols(y);

    matrix[N, K] L;
    matrix[N, K] sq = sq_dist(y, mu);

    for(n in 1:N){
        for(k in 1:K){
            L[n, k] = -D * log(sd[k]) - (sq[n, k] / (2 * square(sd[k]))) - (0.5 * D) * log(2 * pi());
        }
    }
    return L;
}

//@laplace
//@brief Diagonal-covariance Gaussian component log-densities: independent scale per cluster and per feature.
//@param y N x D data matrix
//@param mu K x D matrix of cluster means
//@param S K x D matrix of per-cluster, per-feature standard deviations (not variances)
//@math L_{nk} = -\frac12\sum_{d=1}^{D}\left[\log(2\pi\sigma_{kd}^2) + \frac{(y_{nd}-\mu_{kd})^2}{\sigma_{kd}^2}\right]
//@return N x K matrix of component log-densities
//@example matrix[N, K] L = cluster::diag_loglik(y, mu, S);
matrix diag_loglik(matrix y, matrix mu, matrix S) {
    int N = rows(y);
    int K = rows(mu);
    int D = cols(y);

    matrix[N, K] L;

    for (n in 1:N) {
        for (k in 1:K) {
            L[n, k] = 0;

            for (d in 1:D) {
                L[n, k] += normal_lpdf(y[n, d] | mu[k, d], S[k, d]);
            }
        }
    }
    return L;
}

//@laplace
//@brief Full-covariance Gaussian component log-densities via a per-cluster Cholesky factor.
//@param y N x D data matrix
//@param mu K x D matrix of cluster means
//@param C array of K lower-triangular D x D Cholesky factors, with Sigma_k = C_k * C_k'
//@math L_{nk} = -\frac{D}{2}\log 2\pi - \sum_{d=1}^{D}\log (C_k)_{dd} - \frac12\lVert C_k^{-1}(y_n-\mu_k)\rVert^2
//@return N x K matrix of component log-densities
//@example array[K] matrix[D, D] C; matrix[N, K] L = cluster::mvn_chol_loglik(y, mu, C);
matrix mvn_chol_loglik(matrix y, matrix mu, array[] matrix C){
    int N = rows(y);
    int K = rows(mu);
    int D = cols(y);

    matrix[N, K] L;

    for (n in 1:N) {
        for (k in 1:K) {
            vector[D] residual;
            vector[D] z;
            real log_det_C; // sum of log-diagonal of C[k], i.e. 0.5 * log det(Sigma_k)

            // residual
            residual = (y[n] - mu[k])';
            z        = mdivide_left_tri_low(C[k], residual);

            // sum(log(diagonal(C[k])))
            log_det_C = 0;
            for (d in 1:D) log_det_C += log(C[k, d, d]);
            
            L[n, k] = -0.5 * D * log(2 * pi()) - log_det_C - 0.5 * dot_self(z);
        }
    }
    return L;
}

//@laplace
//@brief Poisson component log-densities, features conditionally independent given the cluster.
//@param y N x D matrix of non-negative integer counts (stored as real)
//@param lambda K x D matrix of per-cluster, per-feature rates
//@math L_{nk} = \sum_{d=1}^{D}\left[y_{nd}\log\lambda_{kd} - \lambda_{kd} - \log\Gamma(y_{nd}+1)\right]
//@return N x K matrix of component log-densities
//@example matrix[N, K] L = cluster::pois_lik(y, lambda);
matrix pois_lik(matrix y, matrix lambda){
    int N = rows(y);
    int D = cols(y);
    int K = rows(lambda);

    matrix[N, K] L;

    for(n in 1:N){
        for(k in 1:K){
            // Initialize L 
            L[n, k] = 0;

            for(d in 1:D){
                real delta_lambda = y[n, d] * log(lambda[k, d]) - lambda[k, d]; // Get the delta lambda
                real fgamma_y = lgamma(y[n, d] + 1);                            // Apply the gamma function for the -log of the matrix outcome + 1
                L[n, k] += delta_lambda - fgamma_y;                             // Accumulate the results D times
            }
        }
    }
    return L;
}

//@laplace
//@brief Negative-binomial (mean/precision) component log-densities, features conditionally independent given the cluster.
//@param y N x D matrix of non-negative integer counts (stored as real)
//@param mu K x D matrix of per-cluster, per-feature means
//@param psi length-K vector of per-cluster precisions (Var = mu + mu^2/psi); as psi -> infinity this approaches pois_lik
//@math L_{nk} = \sum_{d}\left[\log\Gamma(y_{nd}+\psi_k) - \log\Gamma(\psi_k) - \log\Gamma(y_{nd}+1) + y_{nd}\log\frac{\mu_{kd}}{\mu_{kd}+\psi_k} + \psi_k\log\frac{\psi_k}{\mu_{kd}+\psi_k}\right]
//@return N x K matrix of component log-densities
//@example matrix[N, K] L = cluster::negbin_loglik(y, mu, psi);
matrix negbin_loglik(matrix y, matrix mu, vector psi){
    int N = rows(y);
    int K = num_elements(psi);
    int D = cols(y);

    matrix[N, K] L;

    for(n in 1:N){
        for(k in 1:K){
            L[n, k] = 0; 
            real ng_psi_k = lgamma(psi[k]);

            for(d in 1:D){
                // Calc Primaries
                real y_gp = lgamma(y[n, d] + psi[k]); // Y-Psi mean precision 
                real y_p  = lgamma(y[n, d] + 1);      // Y-precision 
                real mu_psi_p = mu[k ,d] + psi[k];    // Mu-Psi Precision

                // Accumulate
                L[n , k] += y_gp - ng_psi_k - y_p + y[n, d] * log(mu[k, d] / mu_psi_p) + psi[k] * log(psi[k] / mu_psi_p);
            }
        }
    }
    return L;
}

//@laplace
//@brief Latent-class (independent Bernoulli item) component log-densities, with support for missing items.
//@param y N x J binary matrix of item responses
//@param p K x J matrix of per-cluster item-endorsement probabilities
//@param m N x J mask matrix (1 = observed, 0 = missing); missing items contribute 0 to the sum
//@math L_{nk} = \sum_{j=1}^{J} m_{nj}\left[y_{nj}\log\pi_{kj} + (1-y_{nj})\log(1-\pi_{kj})\right]
//@return N x K matrix of component log-densities
//@example matrix[N, K] L = cluster::latent_class_loglik(y, p, m);
matrix latent_class_loglik(matrix y, matrix p, matrix m){
    int N = rows(y);
    int J = cols(y);
    int K = rows(p);

    matrix[N, K] L;

    for(n in 1:N){
        for(k in 1:K){
            L[n, k] = 0;

            for(j in 1:J){
                // Get the Bracket expression for cleaner looking accumulation 
                real bracket_term = y[n, j] * log(p[k, j]) + (1 - y[n, j]) * log(1 - p[k, j]);
                // Accumulate to L
                L[n, k] += m[n, j] * bracket_term;
            }
        }
    }
    return L;
}

//@laplace
//@brief Multinomial (bag-of-words / count-vector) component log-densities, e.g. Naive Bayes document clustering.
//@param y N x V matrix of non-negative integer counts (stored as real)
//@param phi K x V matrix of per-cluster word/category probabilities, each row a simplex
//@math L_{nk} = \sum_{v=1}^{V} y_{nv}\log\phi_{kv} + \log\frac{(\sum_v y_{nv})!}{\prod_v y_{nv}!}
//@return N x K matrix of component log-densities
//@example matrix[N, K] L = cluster::multinomial_loglik(y, phi);
matrix multinomial_loglik(matrix y, matrix phi) {
    int N = rows(y);
    int K = rows(phi);
    int V = cols(phi);

    matrix[N, K] L;

    for (n in 1:N) {
        // Initialize
        real sum_nv = 0;
        real log_prod_factorial = 0;

        // Get the accumulated terms
        for (v in 1:V) {
            sum_nv += y[n, v];
            log_prod_factorial += lgamma(y[n, v] + 1);
        }

        for (k in 1:K) {
            L[n, k] = lgamma(sum_nv + 1) - log_prod_factorial;

            for (v in 1:V) {
                L[n, k] += y[n, v] * log(phi[k, v]);
            }
        }
    }

    return L;
}

//@laplace
//@brief Mixture-of-regressions component log-densities: a separate linear regression per cluster.
//@param y length-N response vector
//@param X N x P design matrix (include an intercept column if wanted)
//@param B P x K matrix of per-cluster regression coefficients
//@param sd length-K vector of per-cluster residual standard deviations
//@math L_{nk} = -\log\sigma_k - \frac12\log 2\pi - \frac{(y_n - x_n^{\top}\beta_k)^2}{2\sigma_k^2}
//@return N x K matrix of component log-densities
//@example matrix[N, K] L = cluster::regression_loglik(y, X, B, sd);
matrix regression_loglik(vector y, matrix X, matrix B, vector sd){
    int N = num_elements(y);
    int K = cols(B);

    // Get the mean mu from the XB
    matrix[N, K] mu = X * B;
    matrix[N, K] L;

    for(n in 1:N){
        for(k in 1:K){
            L[n, k] = -log(sd[k]) - (0.5 * log(2 * pi())) - ((square(y[n] - mu[n, k])) / (2 * square(sd[k]))); 
        }
    }
    return L;
}
