//@laplace
//@brief Draw one cluster label per observation from its responsibility row.
//@param R N x K matrix of responsibilities, each row a simplex (see responsibilities)
//@math z_n \sim \text{Categorical}(r_{n\cdot})
//@return length-N integer array of sampled cluster labels in {1,...,K}
//@example array[N] int z = cluster::assign_rng(R);
array[] int assign_rng(matrix R){
    int N = rows(R);
    array[N] int z;
    for (n in 1:N) {
        z[n] = categorical_rng(R[n]');
    }
    return z;
}

//@laplace
//@brief Hard-assign each observation to its most probable cluster (MAP / argmax).
//@param R N x K matrix of responsibilities, each row a simplex (see responsibilities)
//@math \hat z_n = \arg\max_k r_{nk}
//@return length-N integer array of cluster labels in {1,...,K}; ties keep the lowest index
//@example array[N] int z_hat = cluster::map_assign(R);
array[] int map_assign(matrix R){
    int N = rows(R);
    array[N] int z;
    for (n in 1:N) {
        z[n] = 1;
        for (k in 2:cols(R)) {
            if (R[n, k] > R[n, z[n]]) {
                z[n] = k;
            }
        }
    }
    return z;
}

//@laplace
//@brief Per-observation entropy of the cluster assignment (0 = certain, log K = fully uncertain).
//@param R N x K matrix of responsibilities, each row a simplex (see responsibilities)
//@math H_n = -\sum_{k=1}^{K} r_{nk}\log r_{nk}
//@return length-N vector, H_n in [0, log K]; divide by log(K) for a [0,1]-scaled version
//@example vector[N] H = cluster::assignment_entropy(R);
vector assignment_entropy(matrix R){
    int N = rows(R);
    int K = cols(R);

    vector[N] H = rep_vector(0, N);

    for(n in 1:N){
        for(k in 1:K){
            H[n] += -(R[n,k] * log(R[n, k])); 
        }
    }
    return H;
}

//@laplace
//@brief Complete-data log-likelihood (ICL-style criterion), shared weights.
//@param R N x K matrix of responsibilities (must come from the same L, log_theta passed here)
//@param L N x K matrix of component log-densities
//@param log_theta length-K vector of log mixing weights
//@math \sum_{n}\sum_{k} r_{nk}\left(\log\theta_k + L_{nk}\right) = \sum_n \ell_n - \sum_n H_n
//@return scalar; equals mixture_lpdf(L, log_theta) minus the total assignment entropy
//@example real cll = cluster::complete_loglik(R, L, log(theta));
real complete_loglik(matrix R, matrix L, vector log_theta){
    int N = rows(R);
    int K = cols(R);
    real out = 0;

    for (n in 1:N) {
        for (k in 1:K) {
            out += R[n, k] * (log_theta[k] + L[n, k]);
        }
    }
    return out;
}

//@laplace
//@brief Complete-data log-likelihood (ICL-style criterion), covariate-dependent weights.
//@param R N x K matrix of responsibilities (must come from the same L, log_theta passed here)
//@param L N x K matrix of component log-densities
//@param log_theta N x K matrix of observation-specific log mixing weights
//@math \sum_{n}\sum_{k} r_{nk}\left(\log\theta_{nk} + L_{nk}\right) = \sum_n \ell_n - \sum_n H_n
//@return scalar; equals mixture_lpdf(L, log_theta) minus the total assignment entropy
//@example real cll = cluster::complete_loglik(R, L, log_Theta);
real complete_loglik(matrix R, matrix L, matrix log_theta){
    int N = rows(R);
    int K = cols(R);
    real out = 0;

    for (n in 1:N) {
        for (k in 1:K) {
            out += R[n, k] * (log_theta[n, k] + L[n, k]);
        }
    }
    return out;
}

//@laplace
//@brief Posterior co-clustering probability matrix: how often each pair of points shares a cluster.
//@param R N x K matrix of responsibilities, each row a simplex (see responsibilities)
//@math S_{ij} = \sum_{k=1}^{K} r_{ik}\,r_{jk}
//@return N x N matrix, symmetric, diagonal equal to 1, label-switching invariant; O(N^2) memory, save R and compute this outside Stan for large N
//@example matrix[N, N] S = cluster::coclustering(R);
matrix coclustering(matrix R){
    return R * R';
}
